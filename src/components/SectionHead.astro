---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<p class="eyebrow">{eyebrow}</p>
<h2 class="mt-4 text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl">
  {title}
</h2>
<p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-400">{lead}</p>