---
import type { HeroMedia } from '../../lib/hero-media';
import { shouldShowControls } from '../../lib/hero-carousel';

interface Props {
  items: readonly HeroMedia[];
}

const { items } = Astro.props;

/**
 * Progressive enhancement: the dots are part of the server-rendered HTML but
 * only become visible/interactive once the script below marks the carousel as
 * ready. Without JS this renders exactly the scroll-snap track it always did
 * (see the .hero-track comment in src/styles/hero.css).
 */
const showControls = shouldShowControls(items.length);
---

<div
  class="hero-carousel relative flex h-full w-full items-center justify-center"
  data-hero-carousel
>
  {
    items.length > 0 ? (
      <ul class="hero-track mask-[var(--hero-mask)]" data-hero-track>
        {items.map((item) => (
          <li class="hero-slide" data-hero-slide>
            {item.kind === 'video' ? (
              <video
                class="h-full w-full object-cover"
                src={item.src}
                poster={item.poster}
                autoplay
                muted
                loop
                playsinline
                preload="none"
                tabindex="-1"
                aria-label={item.alt}
              />
            ) : (
              <img
                class="h-full w-full object-cover"
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
            )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="mask-[var(--hero-mask)] flex h-full w-full max-w-5xl items-center justify-center border border-dashed border-slate-400/35 bg-abyss-900/60 p-8 text-center">
        <div class="max-w-md space-y-2">
          <p class="ph-chip">CAROUSEL — empty</p>
          <strong class="ph-title">No captures wired up yet.</strong>
          <p class="ph-hint">
            Drop any video or image into <code class="font-mono">public/hero/</code>. A leading
            number orders the carousel; the rest of the filename is up to you.
          </p>
        </div>
      </div>
    )
  }

  {
    showControls && (
      <div class="hero-dots" role="group" aria-label="Select a capture" data-hero-dots>
        {items.map((item, index) => (
          <button
            type="button"
            class="hero-dot"
            data-hero-dot
            aria-label={`Show capture ${index + 1} of ${items.length}: ${item.alt}`}
            aria-current={index === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  import {
    AUTOPLAY_INTERVAL_MS,
    INTERACTION_RESUME_MS,
    MOVEMENT_RESUME_MS,
    createHold,
    nearestIndex,
    nextIndex,
    shouldAutoplay,
    shouldShowControls,
    wrapIndex,
  } from '../../lib/hero-carousel';

  const REDUCED_MOTION_QUERY = '(prefers-reduced-motion: reduce)';

  for (const root of document.querySelectorAll('[data-hero-carousel]')) {
    const track = root.querySelector('[data-hero-track]');
    const dotsWrap = root.querySelector('[data-hero-dots]');
    const slides = track ? Array.from(track.querySelectorAll('[data-hero-slide]')) : [];
    const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('[data-hero-dot]')) : [];

    if (!track || !dotsWrap || !shouldShowControls(slides.length) || dots.length !== slides.length) {
      continue;
    }

    const reduceMotion = window.matchMedia(REDUCED_MOTION_QUERY);

    // Absolute scrollLeft value that brings each slide to its snap position.
    // Measured from the real geometry so the track gap is accounted for.
    let targets = [];
    let index = 0;
    let autoplayTimer;
    let lastPointerType = '';
    let programmatic = false;
    let programmaticFallback;

    const measure = () => {
      const trackLeft = track.getBoundingClientRect().left;
      targets = slides.map((slide) => {
        const rect = slide.getBoundingClientRect();
        const centered =
          track.scrollLeft + (rect.left - trackLeft) - (track.clientWidth - rect.width) / 2;
        return Math.max(0, centered);
      });
    };

    const paint = (next) => {
      index = next;
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
    };

    const goTo = (target, behavior = reduceMotion.matches ? 'auto' : 'smooth') => {
      const next = wrapIndex(target, slides.length);
      paint(next);
      // The smooth scroll we trigger must not be mistaken for user interaction.
      programmatic = true;
      if (programmaticFallback !== undefined) window.clearTimeout(programmaticFallback);
      programmaticFallback = window.setTimeout(() => {
        programmatic = false;
      }, 900);
      track.scrollTo({ left: targets[next], behavior });
    };

    // Level-based pause: every tick reads the live signals, so no stored
    // hover/focus flag can get wedged by a missed event. Hovering the hero at
    // large is not a signal: the carousel fills the viewport, so that would
    // stop auto-advance permanently on desktop.
    const hold = createHold(INTERACTION_RESUME_MS);
    const movingHold = createHold(MOVEMENT_RESUME_MS);
    // Keep the MediaQueryList, not its snapshot: a mouse plugged in (or an
    // emulated `hover: hover`) after load must flip the signal immediately.
    const canHover = window.matchMedia('(hover: hover)');
    const paused = () =>
      document.hidden ||
      // Control under the cursor: `lastPointerType` keeps the sticky `:hover`
      // a tap leaves on a hybrid device from reading as a mouse hover.
      (canHover.matches && lastPointerType !== 'touch' && dotsWrap.matches(':hover')) ||
      !!dotsWrap.querySelector(':focus-visible') || // keyboard focus
      hold.isHolding(Date.now()) || // recent deliberate activity
      movingHold.isHolding(Date.now()); // recent cursor movement (short)

    // Self-rescheduling loop: a paused tick simply postpones itself, so there
    // is no separate re-arm path to forget.
    const tick = () => {
      if (shouldAutoplay(slides.length, { paused: paused() })) goTo(nextIndex(index, slides.length));
      autoplayTimer = window.setTimeout(tick, AUTOPLAY_INTERVAL_MS);
    };

    // Background tabs throttle timers, so a returning tab could wait up to a minute
    // for its next tick. This re-schedules; it is not a pause flag.
    window.addEventListener('visibilitychange', () => {
      if (document.hidden) return;
      window.clearTimeout(autoplayTimer);
      autoplayTimer = window.setTimeout(tick, AUTOPLAY_INTERVAL_MS);
    });

    measure();
    window.addEventListener('resize', measure, { passive: true });

    // The active dot follows the real scroll position, including manual scroll
    // and swipe.
    track.addEventListener(
      'scroll',
      () => {
        const nearest = nearestIndex(track.scrollLeft, targets);
        if (nearest !== index) paint(nearest);
        if (!programmatic) hold(Date.now());
      },
      { passive: true },
    );

    track.addEventListener(
      'scrollend',
      () => {
        programmatic = false;
        if (programmaticFallback !== undefined) window.clearTimeout(programmaticFallback);
        programmaticFallback = undefined;
      },
      { passive: true },
    );

    // Click/tap jumps to a slide; arrow keys move focus between dots.
    dotsWrap.addEventListener('click', (event) => {
      const dot = event.target instanceof Element ? event.target.closest('[data-hero-dot]') : null;
      if (!dot) return;
      goTo(dots.indexOf(dot));
      hold(Date.now());
    });

    // Any touch/click cancels a programmatic scroll and counts as recent
    // activity, so swipe/resume behave even without hovering. It also records
    // which pointer kind produced it, so a touch tap cannot leave a sticky
    // `:hover` reading as a mouse hover.
    root.addEventListener('pointerdown', (event) => {
      lastPointerType = event.pointerType;
      programmatic = false;
      hold(Date.now());
    });

    // Cursor movement is ambient, not deliberate: `pointermove` (mouse, touch
    // and pen) re-triggers the short movingHold. It also records the pointer
    // type, so any real mouse hover (which always ships a `pointermove` on
    // `root`) re-arms the hover signal after a touch interaction. No throttle
    // needed — the write is trivial and dropping intermediate events only loses
    // a re-trigger, never an edge.
    root.addEventListener(
      'pointermove',
      (event) => {
        lastPointerType = event.pointerType;
        movingHold.hold(Date.now());
      },
      { passive: true },
    );

    dotsWrap.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const step = event.key === 'ArrowRight' ? 1 : -1;
      const next = wrapIndex(index + step, dots.length);
      goTo(next);
      dots[next].focus();
      hold(Date.now());
    });

    // The pause signals are read level-based from `:hover`/`:focus-visible` and
    // the interaction hold, so there is nothing to wire here: no durable
    // hover/focus flag that a missed pointerleave/focusout could wedge.

    // A preference change needs no reaction from the timer: `goTo` reads
    // `reduceMotion` on every tick, so the next advance picks up the new scroll
    // behaviour on its own.

    // Progressive enhancement: reveal the dots only now that JS owns them.
    root.setAttribute('data-hero-ready', '');
    paint(nearestIndex(track.scrollLeft, targets));
    autoplayTimer = window.setTimeout(tick, AUTOPLAY_INTERVAL_MS);
  }
</script>
