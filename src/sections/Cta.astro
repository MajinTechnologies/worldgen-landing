---
import Placeholder from '../components/Placeholder.astro';
---

<section id="empezar" class="section">
  <div class="shell">
    <div class="cta">
      <p class="eyebrow">Get started</p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-white text-balance sm:text-4xl">
        Put your world in motion
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-slate-300">
        Ask for access to the package, import it into a test scene and walk. If it works for
        you, take it into your project.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn--primary" href="#contacto">Ask for access</a>
        <a class="btn btn--quiet" href="#capacidades">Review the capabilities</a>
      </div>
      <div id="contacto" class="mt-10">
        <Placeholder
          kind="contact"
          label="CONTACT — to be defined"
          title="Missing the contact or download channel."
          hint="Replace with the real destination: download link, email or external form. The button does not lead anywhere today."
        />
      </div>
    </div>
  </div>
</section>